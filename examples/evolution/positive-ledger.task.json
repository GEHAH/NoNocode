{
  "id": "positive-ledger",
  "prompt": "汇总 examples/evolution/positive-ledger.csv 中所有带符号金额，写入工作区根目录 result.json。total 字段使用保留两位小数的字符串。",
  "inputs": [
    "examples/evolution/positive-ledger.csv"
  ],
  "checks": [
    {
      "type": "json_equals",
      "path": "result.json",
      "pointer": "/total",
      "value": "35.50"
    }
  ],
  "repetitions": 2,
  "timeout_seconds": 60,
  "max_iterations": 8,
  "split": "holdout"
}
